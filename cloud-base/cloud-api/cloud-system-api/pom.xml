<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudai</groupId>
        <artifactId>cloud-api</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cloud-system-api</artifactId>
    <name>cloud-system-api</name>
    <description>cloud-system 服务间契约（Feign 客户端 + inner 契约模型 + 降级工厂）</description>

    <dependencies>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-common-core-starter</artifactId>
        </dependency>
        <!-- 契约模型转换产数据权限组件类型（DataPermScopeVo.toColumnScope()/toRowFilter()、
             PredicateVo 持 FilterColumnTypeEnum）——机器面归组件，2026-11-16 组件抽取 -->
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-common-dataperm-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- 契约模型校验注解（@NotBlank 等，NotifyClient SendByCodeRequest）编译期可见；
             运行时校验器由提供方服务自带（沿 cloud-task-api 同款声明） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
