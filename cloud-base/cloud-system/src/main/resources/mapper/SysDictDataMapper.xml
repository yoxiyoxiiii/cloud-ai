<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudai.system.mapper.SysDictDataMapper">

    <!-- 逻辑删除/审计显式维护，语义说明见 SysUserMapper.xml；value 为 MySQL 非保留关键字，裸用作列名 -->
    <sql id="allColumns">
        id, dict_type_id, label, value, sort, status,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <!-- 分页由 PaginationInnerInterceptor 追加 LIMIT 与 COUNT，SQL 不写 LIMIT；sort 是项的展示序 -->
    <select id="pageListByTypeId" resultType="com.cloudai.system.entity.SysDictData">
        SELECT <include refid="allColumns"/>
          FROM sys_dict_data
         WHERE dict_type_id = #{typeId} AND deleted = 0
         ORDER BY sort ASC, id ASC
    </select>

    <select id="findById" resultType="com.cloudai.system.entity.SysDictData">
        SELECT <include refid="allColumns"/>
          FROM sys_dict_data
         WHERE id = #{id} AND deleted = 0
    </select>

    <select id="countByTypeId" resultType="long">
        SELECT COUNT(*)
          FROM sys_dict_data
         WHERE dict_type_id = #{typeId} AND deleted = 0
    </select>

    <select id="countByTypeValue" resultType="long">
        SELECT COUNT(*)
          FROM sys_dict_data
         WHERE dict_type_id = #{typeId} AND value = #{value} AND deleted = 0
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- 动态列等价 NOT_NULL 字段策略：业务列 null 时省略、交由列默认值；实体属性 dictTypeId ← 列 dict_type_id -->
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_dict_data
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dictTypeId != null">
                dict_type_id,
            </if>
            <if test="label != null">
                label,
            </if>
            <if test="value != null">
                value,
            </if>
            <if test="sort != null">
                sort,
            </if>
            <if test="status != null">
                status,
            </if>
            create_by, create_time, update_by, update_time,
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="dictTypeId != null">
                #{dictTypeId},
            </if>
            <if test="label != null">
                #{label},
            </if>
            <if test="value != null">
                #{value},
            </if>
            <if test="sort != null">
                #{sort},
            </if>
            <if test="status != null">
                #{status},
            </if>
            #{createBy}, #{createTime}, #{updateBy}, #{updateTime},
        </trim>
    </insert>

    <!-- 动态列等价 NOT_NULL 字段策略：null 列不改库值；实体属性 dictTypeId ← 列 dict_type_id -->
    <update id="update">
        UPDATE sys_dict_data
        <set>
            <if test="dictTypeId != null">
                dict_type_id = #{dictTypeId},
            </if>
            <if test="label != null">
                label = #{label},
            </if>
            <if test="value != null">
                value = #{value},
            </if>
            <if test="sort != null">
                sort = #{sort},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
            update_time = #{updateTime},
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

    <!-- update_by 匿名保留原值：<if> 判空，逗号前置 -->
    <update id="deleteById">
        UPDATE sys_dict_data
           SET deleted = 1,
               update_time = #{updateTime}
               <if test="updateBy != null">
                   , update_by = #{updateBy}
               </if>
         WHERE id = #{id} AND deleted = 0
    </update>
</mapper>
