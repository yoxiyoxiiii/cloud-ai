# cloud-base-agent 配置模板（复制为 .env 后填写；.env 已被 .gitignore 忽略）
# 优先级：真实环境变量 > .env > 代码默认值；键前缀 CLOUD_BASE_AI_ 不变，嵌套分隔符双下划线 "__"

# DeepSeek API key（真值仅本地 .env，不提交不入任何文档/日志；空 = LLM 端点报 5002）
CLOUD_BASE_AI_LLM__API_KEY=
CLOUD_BASE_AI_LLM__BASE_URL=
CLOUD_BASE_AI_LLM__MODEL=

# MCP 客户端密钥（与 cloud-system Nacos cloud.mcp.client-secret 同值；agent 发送 / rag 校验）
CLOUD_BASE_AI_MCP__CLIENT_SECRET=

# Database（库名固定 cloud_ai_agent——双库拆分后 agent 八表所在库）
CLOUD_BASE_AI_DB__DATABASE=cloud_ai_agent
# CLOUD_BASE_AI_DB__HOST=127.0.0.1
# CLOUD_BASE_AI_DB__PORT=3306
# CLOUD_BASE_AI_DB__USER=root
# CLOUD_BASE_AI_DB__PASSWORD=

# Redis Cluster（消息存储，默认 127.0.0.1:7000）
# CLOUD_BASE_AI_REDIS__HOSTS=127.0.0.1
# CLOUD_BASE_AI_REDIS__PORT=7000
# CLOUD_BASE_AI_REDIS__PASSWORD=

# 外部 MCP server 凭据（键结构 CLOUD_BASE_AI_MCP__SERVERS__<NAME>__<KEY>；
# DB credential_headers_json 只存键名，真值在此——按需添加，无则外部 server 走无凭据连接）
# CLOUD_BASE_AI_MCP__SERVERS__EXAMPLE__TOKEN=
