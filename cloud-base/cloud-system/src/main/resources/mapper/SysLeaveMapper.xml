<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudai.system.mapper.SysLeaveMapper">

    <!-- 投影轮 2026-10-09 设计 D6：读路径 JOIN approval_projection 派生（写权归框架组件，业务侧只读——
         守护规则 projection_table_readonly_for_business_sql）；
         status = CASE WHEN create_result=2 THEN 4 ELSE IFNULL(approval_status,0) END（契约 §1.5 唯一口径），
         CAST CHAR 规避 mybatis TINYINT→String 映射不确定性（风险 R4）；
         CAST(l.id AS CHAR) 在驱动侧（l），p.business_key 裸列走 uk_business 探针（EXPLAIN 抽查记档） -->
    <sql id="listColumns">
        l.id, l.title, l.leave_type, l.start_date, l.end_date, l.reason, l.apply_user, l.approver, l.create_time,
        p.approval_id,
        CAST(CASE WHEN p.create_result = 2 THEN 4 ELSE IFNULL(p.approval_status, 0) END AS CHAR) AS status
    </sql>

    <!-- 详情读：投影无行（存量/事件未达）→ status=0、approval_id NULL（LEFT JOIN 语义） -->
    <select id="findById" resultType="com.cloudai.system.vo.SysLeaveVo">
        SELECT <include refid="listColumns"/>
          FROM sys_leave l
          LEFT JOIN approval_projection p
            ON p.business_type = #{businessType} AND p.business_key = CAST(l.id AS CHAR)
         WHERE l.id = #{id} AND l.deleted = 0
    </select>

    <!-- 分页由 PaginationInnerInterceptor 追加 LIMIT 与 COUNT，SQL 不写 LIMIT；
         谓词轮（设计 D33/契约 §4.1）：行集 = RowFilter 组间 OR——rowAll=true 过滤豁免；
         组 = (allAccounts || l.apply_user IN accounts) AND 组谓词全过（值类型化绑定，D33）。
         列名硬编码 choose 分支是字符串占位禁令（守护测试禁 dollar 占位）的必然对价
         （每列×合法操作符，设计 §5.4b）；
         otherwise 1 = 0 fail-closed：未匹配分支按恒假处理（不放大授权，求值器 enrichment
         已过滤越界字段——本层是纵深防御）。IN 命中 idx_apply_user(apply_user, deleted)；
         空集范围 Service 短路不达此处（防 IN ()） -->
    <select id="pageList" resultType="com.cloudai.system.vo.SysLeaveVo">
        SELECT <include refid="listColumns"/>
          FROM sys_leave l
          LEFT JOIN approval_projection p
            ON p.business_type = #{businessType} AND p.business_key = CAST(l.id AS CHAR)
         WHERE l.deleted = 0
         <if test="filter.rowAll == false">
             AND
             <foreach collection="filter.groups" item="grp" open="(" separator=" OR " close=")">
                 <choose>
                     <when test="grp.allAccounts">
                         1 = 1
                     </when>
                     <otherwise>
                         l.apply_user IN
                         <foreach collection="grp.accounts" item="account" open="(" separator="," close=")">
                             #{account}
                         </foreach>
                     </otherwise>
                 </choose>
                 <foreach collection="grp.predicates" item="p">
                     <choose>
                         <when test="p.field == 'id'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND l.id = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND l.id IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'BETWEEN'">
                                     AND l.id BETWEEN #{p.values[0]} AND #{p.values[1]}
                                 </when>
                                 <when test="p.operator == 'GTE'">
                                     AND l.id &gt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LTE'">
                                     AND l.id &lt;= #{p.values[0]}
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>
                         <when test="p.field == 'leaveType'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND l.leave_type = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND l.leave_type IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'BETWEEN'">
                                     AND l.leave_type BETWEEN #{p.values[0]} AND #{p.values[1]}
                                 </when>
                                 <when test="p.operator == 'GTE'">
                                     AND l.leave_type &gt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LTE'">
                                     AND l.leave_type &lt;= #{p.values[0]}
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>
                         <when test="p.field == 'startDate'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND l.start_date = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND l.start_date IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'BETWEEN'">
                                     AND l.start_date BETWEEN #{p.values[0]} AND #{p.values[1]}
                                 </when>
                                 <when test="p.operator == 'GTE'">
                                     AND l.start_date &gt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LTE'">
                                     AND l.start_date &lt;= #{p.values[0]}
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>
                         <when test="p.field == 'endDate'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND l.end_date = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND l.end_date IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'BETWEEN'">
                                     AND l.end_date BETWEEN #{p.values[0]} AND #{p.values[1]}
                                 </when>
                                 <when test="p.operator == 'GTE'">
                                     AND l.end_date &gt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LTE'">
                                     AND l.end_date &lt;= #{p.values[0]}
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>
                         <otherwise>
                             AND 1 = 0
                         </otherwise>
                     </choose>
                 </foreach>
             </foreach>
         </if>
         ORDER BY l.id DESC
    </select>

    <!-- MQ 事务消息形态：snowflake 预生成 id 显式插入（半消息体发送前需知 businessKey，设计 R2）；
         纯业务行无状态列（状态真相=投影派生读） -->
    <insert id="save">
        INSERT INTO sys_leave (id, title, leave_type, start_date, end_date, reason,
                               apply_user, approver, create_by, create_time, update_by, update_time)
        VALUES (#{id}, #{title}, #{leaveType}, #{startDate}, #{endDate}, #{reason},
                #{applyUser}, #{approver}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime})
    </insert>
</mapper>
