# cloud-base-ai LLM 配置模板（复制为 .env 后填写；.env 已被 .gitignore 忽略）
# 优先级：真实环境变量 > .env > 代码默认值；键名与契约 2026-10-13-ai-rag-chat-api.md §7 一致
# 注意：嵌套分隔符是双下划线 "__"

# DeepSeek API key（⚠️ 真值仅本地 .env，不提交不写入任何文档/日志/代码；空 = LLM 端点报 5002）
CLOUD_BASE_AI_LLM__API_KEY=

# OpenAI 兼容端点（默认 DeepSeek，可不填）
CLOUD_BASE_AI_LLM__BASE_URL=

# 模型名（默认 deepseek-flash，可不填）
CLOUD_BASE_AI_LLM__MODEL=

# 单次 LLM 请求超时秒数（默认 60）
CLOUD_BASE_AI_LLM__TIMEOUT=

# SDK 内建重试次数（默认 1）
CLOUD_BASE_AI_LLM__MAX_RETRIES=

# 服务层历史截断条数（默认 20）
CLOUD_BASE_AI_LLM__HISTORY_LIMIT=

# ---- Database（MySQL，默认本机事实值零配置即连；跨环境覆盖示例）----
# CLOUD_BASE_AI_DB__HOST=127.0.0.1
# CLOUD_BASE_AI_DB__PORT=3306
# CLOUD_BASE_AI_DB__USER=root
# CLOUD_BASE_AI_DB__PASSWORD=
# CLOUD_BASE_AI_DB__DATABASE=cloud_ai

# ---- MinIO 对象存储（endpoint/bucket 默认本机事实值；凭证真值仅本地 .env）----
# CLOUD_BASE_AI_MINIO__ENDPOINT=127.0.0.1:9100
# CLOUD_BASE_AI_MINIO__ACCESS_KEY=
# CLOUD_BASE_AI_MINIO__SECRET_KEY=
# CLOUD_BASE_AI_MINIO__BUCKET=cloud-ai
