<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudai.system.mapper.SysMenuMapper">

    <!-- 逻辑删除/审计显式维护，语义说明见 SysUserMapper.xml -->
    <!-- is_builtin 只读列：仅查询加载供保护校验，INSERT/UPDATE 列枚举不含（结构性防篡改，新增行落 DEFAULT 0） -->
    <sql id="allColumns">
        id, parent_id, name, perms, type, path, icon, sort, status, is_builtin,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <select id="listAll" resultType="com.cloudai.system.entity.SysMenu">
        SELECT <include refid="allColumns"/>
          FROM sys_menu
         WHERE deleted = 0
         ORDER BY sort, id
    </select>

    <select id="findById" resultType="com.cloudai.system.entity.SysMenu">
        SELECT <include refid="allColumns"/>
          FROM sys_menu
         WHERE id = #{id} AND deleted = 0
    </select>

    <select id="countByParentId" resultType="long">
        SELECT COUNT(*)
          FROM sys_menu
         WHERE parent_id = #{parentId} AND deleted = 0
    </select>

    <!-- 当前用户导航聚合（契约 2026-10-07-menu-nav-api.md §2，范式同 listPermsByAccount）：
         user → user_role → 启用未删角色 → role_menu → 启用未删菜单，DISTINCT 多角色共享菜单去重；
         排除规则 1：F 型按钮不进导航（只留目录 M 或带 path 的 C）；
         排除规则 2：空 path 的 C"绑而不可导航"（如种子 21 在线用户，页面未开发） -->
    <select id="listNavByAccount" resultType="com.cloudai.system.entity.SysMenu">
        SELECT DISTINCT m.id, m.parent_id, m.name, m.type, m.path, m.icon, m.sort
          FROM sys_user u
          JOIN sys_user_role ur ON ur.user_id = u.id
          JOIN sys_role r ON r.id = ur.role_id AND r.status = 0 AND r.deleted = 0
          JOIN sys_role_menu rm ON rm.role_id = r.id
          JOIN sys_menu m ON m.id = rm.menu_id AND m.status = 0 AND m.deleted = 0
                           AND (m.type = 'M' OR m.path != '')
         WHERE u.account = #{account} AND u.deleted = 0
         ORDER BY m.sort, m.id
    </select>

    <!-- 动态列等价原 insert 的 NOT_NULL 字段策略：业务列 null 时省略、交由列默认值 -->
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_menu
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">
                parent_id,
            </if>
            <if test="name != null">
                name,
            </if>
            <if test="perms != null">
                perms,
            </if>
            <if test="type != null">
                type,
            </if>
            <if test="path != null">
                path,
            </if>
            <if test="icon != null">
                icon,
            </if>
            <if test="sort != null">
                sort,
            </if>
            <if test="status != null">
                status,
            </if>
            create_by, create_time, update_by, update_time,
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">
                #{parentId},
            </if>
            <if test="name != null">
                #{name},
            </if>
            <if test="perms != null">
                #{perms},
            </if>
            <if test="type != null">
                #{type},
            </if>
            <if test="path != null">
                #{path},
            </if>
            <if test="icon != null">
                #{icon},
            </if>
            <if test="sort != null">
                #{sort},
            </if>
            <if test="status != null">
                #{status},
            </if>
            #{createBy}, #{createTime}, #{updateBy}, #{updateTime},
        </trim>
    </insert>

    <!-- 动态列等价原 updateById 的 NOT_NULL 字段策略：null 列不改库值 -->
    <update id="update">
        UPDATE sys_menu
        <set>
            <if test="parentId != null">
                parent_id = #{parentId},
            </if>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="perms != null">
                perms = #{perms},
            </if>
            <if test="type != null">
                type = #{type},
            </if>
            <if test="path != null">
                path = #{path},
            </if>
            <if test="icon != null">
                icon = #{icon},
            </if>
            <if test="sort != null">
                sort = #{sort},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
            update_time = #{updateTime},
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

    <update id="deleteById">
        UPDATE sys_menu
           SET deleted = 1,
               update_time = #{updateTime}
               <if test="updateBy != null">
                   , update_by = #{updateBy}
               </if>
         WHERE id = #{id} AND deleted = 0
    </update>
</mapper>
