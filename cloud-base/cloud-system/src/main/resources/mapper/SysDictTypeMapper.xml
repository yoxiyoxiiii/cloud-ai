<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudai.system.mapper.SysDictTypeMapper">

    <!-- 逻辑删除/审计显式维护，语义说明见 SysUserMapper.xml -->
    <!-- is_builtin 只读列：仅查询加载供保护校验，INSERT/UPDATE 列枚举不含（结构性防篡改，新增行落 DEFAULT 0） -->
    <sql id="allColumns">
        id, dict_name, dict_key, status, is_builtin,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <!-- 分页由 PaginationInnerInterceptor 追加 LIMIT 与 COUNT，SQL 不写 LIMIT -->
    <select id="pageList" resultType="com.cloudai.system.entity.SysDictType">
        SELECT <include refid="allColumns"/>
          FROM sys_dict_type
         WHERE deleted = 0
         ORDER BY id DESC
    </select>

    <select id="findById" resultType="com.cloudai.system.entity.SysDictType">
        SELECT <include refid="allColumns"/>
          FROM sys_dict_type
         WHERE id = #{id} AND deleted = 0
    </select>

    <select id="countByDictKey" resultType="long">
        SELECT COUNT(*)
          FROM sys_dict_type
         WHERE dict_key = #{dictKey} AND deleted = 0
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- 动态列等价 NOT_NULL 字段策略：业务列 null 时省略、交由列默认值 -->
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_dict_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dictName != null">
                dict_name,
            </if>
            <if test="dictKey != null">
                dict_key,
            </if>
            <if test="status != null">
                status,
            </if>
            create_by, create_time, update_by, update_time,
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="dictName != null">
                #{dictName},
            </if>
            <if test="dictKey != null">
                #{dictKey},
            </if>
            <if test="status != null">
                #{status},
            </if>
            #{createBy}, #{createTime}, #{updateBy}, #{updateTime},
        </trim>
    </insert>

    <!-- 动态列等价 NOT_NULL 字段策略：null 列不改库值 -->
    <update id="update">
        UPDATE sys_dict_type
        <set>
            <if test="dictName != null">
                dict_name = #{dictName},
            </if>
            <if test="dictKey != null">
                dict_key = #{dictKey},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
            update_time = #{updateTime},
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

    <!-- update_by 匿名保留原值：<if> 判空，逗号前置 -->
    <update id="deleteById">
        UPDATE sys_dict_type
           SET deleted = 1,
               update_time = #{updateTime}
               <if test="updateBy != null">
                   , update_by = #{updateBy}
               </if>
         WHERE id = #{id} AND deleted = 0
    </update>
</mapper>
