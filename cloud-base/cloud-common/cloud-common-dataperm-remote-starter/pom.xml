<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudai</groupId>
        <artifactId>cloud-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cloud-common-dataperm-remote-starter</artifactId>
    <name>cloud-common-dataperm-remote-starter</name>
    <description>数据权限远端求值后端（程序式 Feign 客户端 + RemoteDataPermEvaluationProvider，消费方引依赖即用；system 不引入——本地 Provider 优先）</description>

    <dependencies>
        <!-- 求值 SPI 与机器面来自主 starter -->
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-common-dataperm-starter</artifactId>
        </dependency>
        <!-- 求值契约接口与 wire 模型归提供方 api 模块（DataPermClient/DataPermScopeVo），纯 jar 无装配副作用 -->
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-system-api</artifactId>
        </dependency>
        <!-- 求值账号解析（SecurityUtils.currentAccount，X-User-* 头构建的登录上下文） -->
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-common-security-starter</artifactId>
        </dependency>
        <!-- 程序式 Feign 客户端（FeignClientBuilder + FeignAutoConfiguration）与负载均衡寻址（服务名 → 实例）；
             版本随根 pom dependencyManagement 收敛，不设 optional——模块存在的意义即引入 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
