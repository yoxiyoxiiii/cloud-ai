<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudai.bpmn.mapper.BpmnApprovalMapper">

    <!-- 逻辑删除/审计显式维护，语义说明见 SysUserMapper.xml 头注（三胞胎同款约定）；
         本表无删除端点（审批留档语义），deleteById 不存在——deleted 列仅为 BaseEntity 规范一致性，
         行永不删 → uk_business(business_type, business_key) 无墓碑占键问题（跨终态生效，契约 §1） -->
    <sql id="allColumns">
        id, business_type, business_key, title, process_key, status,
        apply_user, approver, process_instance_id,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <select id="findById" resultType="com.cloudai.bpmn.entity.BpmnApproval">
        SELECT <include refid="allColumns"/>
          FROM bpmn_approval
         WHERE id = #{id} AND deleted = 0
    </select>

    <!-- uk_business 唯一路径：发起查重（任意状态存在即拒 4015）与 /inner cancel 业务键定位共用；LIMIT 1 唯一键防御 -->
    <select id="findByBusiness" resultType="com.cloudai.bpmn.entity.BpmnApproval">
        SELECT <include refid="allColumns"/>
          FROM bpmn_approval
         WHERE business_type = #{businessType} AND business_key = #{businessKey} AND deleted = 0
         LIMIT 1
    </select>

    <!-- 分页由 PaginationInnerInterceptor 追加 LIMIT 与 COUNT，SQL 不写 LIMIT；
         谓词轮（设计 D33/契约 §4.1）：行集 = RowFilter 组间 OR——rowAll=true 过滤豁免；
         组 = (allAccounts || apply_user IN accounts) AND 组谓词全过（值类型化绑定，D33）。
         列名硬编码 choose 分支是字符串占位禁令（守护测试禁 dollar 占位）的必然对价
         （businessType STRING 仅 EQ/IN 两支——矩阵违例组合配置态已 3036 拦截，
         otherwise 1 = 0 为纵深防御 fail-closed）；
         IN 命中 idx_apply_user(apply_user, deleted)（range scan）；
         空集范围 Service 短路不达此处（防 IN ()）；
         操作符扩展轮（2026-10-11 D41-D47）：id/status/create_time +GT/LT/NE、businessType
         +NE/PREFIX、新增 title 列块（EQ/IN/NE/PREFIX——PREFIX 三层竖线 REPLACE 转义链 +
         ESCAPE '|'），分支计数 32 -->
    <select id="pageList" resultType="com.cloudai.bpmn.entity.BpmnApproval">
        SELECT <include refid="allColumns"/>
          FROM bpmn_approval
         WHERE deleted = 0
         <if test="filter.rowAll == false">
             AND
             <foreach collection="filter.groups" item="grp" open="(" separator=" OR " close=")">
                 <choose>
                     <when test="grp.allAccounts">
                         1 = 1
                     </when>
                     <otherwise>
                         apply_user IN
                         <foreach collection="grp.accounts" item="account" open="(" separator="," close=")">
                             #{account}
                         </foreach>
                     </otherwise>
                 </choose>
                 <foreach collection="grp.predicates" item="p">
                     <choose>
                         <!-- id（NUMBER）：EQ/IN/BETWEEN/GTE/LTE/GT/LT/NE（操作符扩展轮 D44 +GT/LT/NE，D47） -->
                         <when test="p.field == 'id'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND id = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND id IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'BETWEEN'">
                                     AND id BETWEEN #{p.values[0]} AND #{p.values[1]}
                                 </when>
                                 <when test="p.operator == 'GTE'">
                                     AND id &gt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LTE'">
                                     AND id &lt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'GT'">
                                     AND id &gt; #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LT'">
                                     AND id &lt; #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'NE'">
                                     AND id != #{p.values[0]}
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>

                         <!-- status（NUMBER，字典 bpmn_approval_status）：EQ/IN/BETWEEN/GTE/LTE/GT/LT/NE（D44/D47） -->
                         <when test="p.field == 'status'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND status = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND status IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'BETWEEN'">
                                     AND status BETWEEN #{p.values[0]} AND #{p.values[1]}
                                 </when>
                                 <when test="p.operator == 'GTE'">
                                     AND status &gt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LTE'">
                                     AND status &lt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'GT'">
                                     AND status &gt; #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LT'">
                                     AND status &lt; #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'NE'">
                                     AND status != #{p.values[0]}
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>

                         <!-- businessType（STRING）：EQ/IN/NE/PREFIX（扩展轮 D41 +NE/PREFIX，D47）——
                              PREFIX 三层竖线 REPLACE 转义链（| doubling 先行，% _ 次之；ESCAPE '|'） -->
                         <when test="p.field == 'businessType'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND business_type = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND business_type IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'NE'">
                                     AND business_type != #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'PREFIX'">
                                     AND business_type LIKE CONCAT(REPLACE(REPLACE(REPLACE(#{p.values[0]}, '|', '||'), '%', '|%'), '_', '|_'), '%') ESCAPE '|'
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>

                         <!-- createTime（DATETIME）：EQ/IN/BETWEEN/GTE/LTE/GT/LT/NE（D44/D47） -->
                         <when test="p.field == 'createTime'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND create_time = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND create_time IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'BETWEEN'">
                                     AND create_time BETWEEN #{p.values[0]} AND #{p.values[1]}
                                 </when>
                                 <when test="p.operator == 'GTE'">
                                     AND create_time &gt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LTE'">
                                     AND create_time &lt;= #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'GT'">
                                     AND create_time &gt; #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'LT'">
                                     AND create_time &lt; #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'NE'">
                                     AND create_time != #{p.values[0]}
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>

                         <!-- title（STRING）：EQ/IN/NE/PREFIX（D42/D43/D47）——PREFIX 三层竖线 REPLACE 转义链
                              （| doubling 先行，% _ 次之；ESCAPE '|' 实证 P10/P11；未转义通配符=过度授权）；
                              test()=startsWithIgnoreCase 双侧不 stripTrailing（探针 P2-P5） -->
                         <when test="p.field == 'title'">
                             <choose>
                                 <when test="p.operator == 'EQ'">
                                     AND title = #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'IN'">
                                     AND title IN
                                     <foreach collection="p.values" item="v" open="(" separator="," close=")">
                                         #{v}
                                     </foreach>
                                 </when>
                                 <when test="p.operator == 'NE'">
                                     AND title != #{p.values[0]}
                                 </when>
                                 <when test="p.operator == 'PREFIX'">
                                     AND title LIKE CONCAT(REPLACE(REPLACE(REPLACE(#{p.values[0]}, '|', '||'), '%', '|%'), '_', '|_'), '%') ESCAPE '|'
                                 </when>
                                 <otherwise>
                                     AND 1 = 0
                                 </otherwise>
                             </choose>
                         </when>
                         <otherwise>
                             AND 1 = 0
                         </otherwise>
                     </choose>
                 </foreach>
             </foreach>
         </if>
         ORDER BY id DESC
    </select>

    <!-- 批量按业务键查（/inner status-list 纠偏回源）：单批 ≤100 由调用方（system 纠偏分批）保证 -->
    <select id="listByBusinessKeys" resultType="com.cloudai.bpmn.entity.BpmnApproval">
        SELECT <include refid="allColumns"/>
          FROM bpmn_approval
         WHERE business_type = #{businessType} AND deleted = 0
           AND business_key IN
           <foreach collection="businessKeys" item="key" open="(" separator="," close=")">
               #{key}
           </foreach>
    </select>

    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bpmn_approval (business_type, business_key, title, process_key, status,
                                   apply_user, approver, process_instance_id,
                                   create_by, create_time, update_by, update_time)
        VALUES (#{businessType}, #{businessKey}, #{title}, #{processKey}, #{status},
                #{applyUser}, #{approver}, #{processInstanceId},
                #{createBy}, NOW(), #{updateBy}, NOW())
    </insert>

    <!-- 状态回写：status + process_instance_id + 操作人（update_time 取 NOW()；发起回填/办理回写/撤销共用；
         撤销传 processInstanceId=null 清空实例关联，契约 §3.1 processInstanceId 撤销后 null） -->
    <update id="updateStatusById">
        UPDATE bpmn_approval
           SET status = #{status},
               process_instance_id = #{processInstanceId},
               update_time = NOW()
               <if test="updateBy != null">
                   , update_by = #{updateBy}
               </if>
         WHERE id = #{id} AND deleted = 0
    </update>
</mapper>
