<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudai.system.mapper.SysRoleMapper">

    <!-- 逻辑删除/审计显式维护，语义说明见 SysUserMapper.xml -->
    <!-- is_builtin 只读列：仅查询加载供保护校验，INSERT/UPDATE 列枚举不含（结构性防篡改，新增行落 DEFAULT 0） -->
    <sql id="allColumns">
        id, name, role_key, status, is_builtin,
        create_by, create_time, update_by, update_time, deleted
    </sql>

    <!-- 分页由 PaginationInnerInterceptor 追加 LIMIT 与 COUNT，SQL 不写 LIMIT -->
    <select id="pageList" resultType="com.cloudai.system.entity.SysRole">
        SELECT <include refid="allColumns"/>
          FROM sys_role
         WHERE deleted = 0
         ORDER BY id DESC
    </select>

    <select id="listEnabled" resultType="com.cloudai.system.entity.SysRole">
        SELECT <include refid="allColumns"/>
          FROM sys_role
         WHERE status = 0 AND deleted = 0
         ORDER BY id
    </select>

    <select id="findById" resultType="com.cloudai.system.entity.SysRole">
        SELECT <include refid="allColumns"/>
          FROM sys_role
         WHERE id = #{id} AND deleted = 0
    </select>

    <!-- 数据权限规则分页行 subjectName 批量回填；ids 空集由 Service 跳过（防 IN ()），已删角色缺名由调用方降级 -->
    <select id="listByIds" resultType="com.cloudai.system.entity.SysRole">
        SELECT id, name
          FROM sys_role
         WHERE deleted = 0
           AND id IN
           <foreach collection="ids" item="id" open="(" separator="," close=")">
               #{id}
           </foreach>
    </select>

    <select id="countByRoleKey" resultType="long">
        SELECT COUNT(*)
          FROM sys_role
         WHERE role_key = #{roleKey} AND deleted = 0
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- 数据权限求值输入（设计 §5.2）：用户 → 用户-角色 → 启用角色 id；聚合跨表放主表 mapper（沿 listPermsByAccount 先例） -->
    <select id="listEnabledRoleIdsByUserId" resultType="long">
        SELECT r.id
          FROM sys_role r
          JOIN sys_user_role ur ON ur.role_id = r.id
         WHERE ur.user_id = #{userId} AND r.status = 0 AND r.deleted = 0
    </select>

    <!-- 动态列等价原 insert 的 NOT_NULL 字段策略：业务列 null 时省略、交由列默认值 -->
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_role
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">
                name,
            </if>
            <if test="roleKey != null">
                role_key,
            </if>
            <if test="status != null">
                status,
            </if>
            create_by, create_time, update_by, update_time,
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="name != null">
                #{name},
            </if>
            <if test="roleKey != null">
                #{roleKey},
            </if>
            <if test="status != null">
                #{status},
            </if>
            #{createBy}, #{createTime}, #{updateBy}, #{updateTime},
        </trim>
    </insert>

    <!-- 动态列等价原 updateById 的 NOT_NULL 字段策略：null 列不改库值 -->
    <update id="update">
        UPDATE sys_role
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="roleKey != null">
                role_key = #{roleKey},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
            update_time = #{updateTime},
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

    <update id="deleteById">
        UPDATE sys_role
           SET deleted = 1,
               update_time = #{updateTime}
               <if test="updateBy != null">
                   , update_by = #{updateBy}
               </if>
         WHERE id = #{id} AND deleted = 0
    </update>
</mapper>
