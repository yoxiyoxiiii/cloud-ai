# cloud-base-rag 配置模板（复制为 .env 后填写；.env 已被 .gitignore 忽略）
# 优先级：真实环境变量 > .env > 代码默认值；键前缀 CLOUD_BASE_AI_ 不变，嵌套分隔符双下划线 "__"

# DeepSeek API key（真值仅本地 .env，不提交不入任何文档/日志；空 = LLM 端点报 5002）
CLOUD_BASE_AI_LLM__API_KEY=
CLOUD_BASE_AI_LLM__BASE_URL=
CLOUD_BASE_AI_LLM__MODEL=

# MCP 客户端密钥（与 cloud-system Nacos cloud.mcp.client-secret 同值；rag 校验 / agent 发送）
CLOUD_BASE_AI_MCP__CLIENT_SECRET=

# Database（库名固定 cloud_ai_rag——双库拆分后 rag 五表所在库）
CLOUD_BASE_AI_DB__DATABASE=cloud_ai_rag
# CLOUD_BASE_AI_DB__HOST=127.0.0.1
# CLOUD_BASE_AI_DB__PORT=3306
# CLOUD_BASE_AI_DB__USER=root
# CLOUD_BASE_AI_DB__PASSWORD=

# Milvus 向量库（rag 检索管线）
# CLOUD_BASE_AI_MILVUS__URI=http://127.0.0.1:19530

# MinIO 对象存储（知识库文件）
CLOUD_BASE_AI_MINIO__ENDPOINT=127.0.0.1:9100
CLOUD_BASE_AI_MINIO__ACCESS_KEY=
CLOUD_BASE_AI_MINIO__SECRET_KEY=
CLOUD_BASE_AI_MINIO__BUCKET=cloud-ai

# Embedding（Ollama 本地端点）
# CLOUD_BASE_AI_EMBEDDING_LLM__BASE_URL=http://127.0.0.1:11434
# CLOUD_BASE_AI_EMBEDDING_LLM__MODEL=qllama/bge-large-zh-v1.5:latest

# Redis Cluster（消息存储，默认 127.0.0.1:7000）
# CLOUD_BASE_AI_REDIS__HOSTS=127.0.0.1
# CLOUD_BASE_AI_REDIS__PORT=7000
# CLOUD_BASE_AI_REDIS__PASSWORD=

# 会话 Redis（Java 侧单机 6379，MCP 认证中间件读 sso:online:{jti}）
# CLOUD_BASE_AI_SSO_REDIS__HOST=127.0.0.1
# CLOUD_BASE_AI_SSO_REDIS__PORT=6379
# CLOUD_BASE_AI_SSO_REDIS__PASSWORD=
