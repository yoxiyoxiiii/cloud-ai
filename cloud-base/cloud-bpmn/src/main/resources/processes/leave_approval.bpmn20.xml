<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://www.flowable.org/processdef">

    <!-- 请假审批（审批平台化 2026-10-08 契约 §1）：单人审批线性流 + 排他网关二分支。
         流程变量（平台规范四变量+透传）：approvalId/applyUser/approver/title（发起注入），
         approve(Boolean)（办理注入）；原 leaveId 变量已废弃。
         结束态判定按 endActivityId：endApprove→已通过 / endReject→已拒绝。
         部署：classpath resources/processes 目录随启动自动部署（内容 hash 未变不重复部署）。 -->
    <process id="leave_approval" name="请假审批" isExecutable="true">

        <startEvent id="start" name="发起申请"/>

        <sequenceFlow id="flowStart" sourceRef="start" targetRef="approval"/>

        <userTask id="approval" name="审批" flowable:assignee="${approver}"/>

        <sequenceFlow id="flowApproval" sourceRef="approval" targetRef="decision"/>

        <exclusiveGateway id="decision" name="审批分支"/>

        <sequenceFlow id="flowApprove" sourceRef="decision" targetRef="endApprove">
            <conditionExpression xsi:type="tFormalExpression">${approve == true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flowReject" sourceRef="decision" targetRef="endReject">
            <conditionExpression xsi:type="tFormalExpression">${approve == false}</conditionExpression>
        </sequenceFlow>

        <endEvent id="endApprove" name="审批通过"/>

        <endEvent id="endReject" name="审批拒绝"/>

    </process>

    <!-- 图形布局信息（DI）：bpmn-js 前端渲染必需（无 DI 则 importXML 报 no diagram to display）；
         仅布局坐标，process 语义（id/assignee/条件表达式）与上块零关联。手工从左到右布局：
         start → approval → decision → 上 endApprove（通过）/ 下 endReject（拒绝）。 -->
    <bpmndi:BPMNDiagram id="BPMNDiagram_leave_approval">
        <bpmndi:BPMNPlane bpmnElement="leave_approval" id="BPMNPlane_leave_approval">
            <bpmndi:BPMNShape bpmnElement="start" id="BPMNShape_start">
                <omgdc:Bounds height="36.0" width="36.0" x="152.0" y="241.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="approval" id="BPMNShape_approval">
                <omgdc:Bounds height="80.0" width="100.0" x="230.0" y="219.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="decision" id="BPMNShape_decision" isMarkerVisible="true">
                <omgdc:Bounds height="40.0" width="40.0" x="380.0" y="235.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="endApprove" id="BPMNShape_endApprove">
                <omgdc:Bounds height="28.0" width="28.0" x="490.0" y="100.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape bpmnElement="endReject" id="BPMNShape_endReject">
                <omgdc:Bounds height="28.0" width="28.0" x="490.0" y="350.0"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge bpmnElement="flowStart" id="BPMNEdge_flowStart">
                <omgdi:waypoint x="188.0" y="259.0"/>
                <omgdi:waypoint x="230.0" y="259.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowApproval" id="BPMNEdge_flowApproval">
                <omgdi:waypoint x="330.0" y="259.0"/>
                <omgdi:waypoint x="380.0" y="255.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowApprove" id="BPMNEdge_flowApprove">
                <omgdi:waypoint x="420.0" y="255.0"/>
                <omgdi:waypoint x="455.0" y="255.0"/>
                <omgdi:waypoint x="455.0" y="114.0"/>
                <omgdi:waypoint x="490.0" y="114.0"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge bpmnElement="flowReject" id="BPMNEdge_flowReject">
                <omgdi:waypoint x="420.0" y="255.0"/>
                <omgdi:waypoint x="455.0" y="255.0"/>
                <omgdi:waypoint x="455.0" y="364.0"/>
                <omgdi:waypoint x="490.0" y="364.0"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>

</definitions>
